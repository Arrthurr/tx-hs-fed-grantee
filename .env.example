# Copy to .env.local (ignored by git) and replace the placeholders:
#   cp .env.example .env.local
# VITE_* values are embedded in the public browser bundle. Never put
# server-side secrets here, and never commit a real key.

# Required for the map to render. Restrict the key by HTTP referrer and API.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional custom Google Maps Map ID:
# VITE_GOOGLE_MAPS_MAP_ID=your_map_id_here
